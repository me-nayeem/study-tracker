generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String?         @db.VarChar(120)
  email          String?         @unique @db.VarChar(255)
  emailVerified  DateTime?
  passwordHash   String?         @db.VarChar(255)
  image          String?         @db.VarChar(255)
  role           Role            @default(STUDENT)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  auditLogs      AuditLog[]      @relation("StaffAuditLogs")
  notifications  Notification[]
  purchases      Purchase[]
  sessions       Session[]
  studentProfile StudentProfile?
  subscription   Subscription?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String     @db.VarChar(255)
  codeHash   String     @db.VarChar(255)
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
}

model StudentProfile {
  id                    String                @id @default(cuid())
  userId                String                @unique
  trackId               String
  board                 Board?
  institutionName       String?               @db.VarChar(160)
  phoneNumber           String?               @unique @db.VarChar(20)
  streakCount           Int                   @default(0)
  lastActiveAt          DateTime?
  totalPoints           Int                   @default(0)
  level                 Int                   @default(1)
  lastShownLevel        Int                   @default(1)
  createdAt             DateTime              @default(now())
  pwaInstallDismissedAt DateTime?
  pwaInstalled          Boolean               @default(false)
  chapterMasteries      ChapterMastery[]
  examResults           ExamResult[]
  feedback Feedback[]
  leaderboardSnapshots  LeaderboardSnapshot[]
  playlistReviews       PlaylistReview[]
  playlistVideoProgress PlaylistVideoProgress[]
  pointTransactions     PointTransaction[]
  quizAttempts          QuizAttempt[]
  notes                 StudentNote[]
  noteComments          StudentNoteComment[]
  noteLikes             StudentNoteLike[]
  noteRatings           StudentNoteRating[]
  track                 Track                 @relation(fields: [trackId], references: [id])
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyRoutines         StudyRoutine[]
  studySessions         StudySession[]
  todoItems             TodoItem[]
  topicProgress         TopicProgress[]

  @@index([trackId, totalPoints])
}

model Track {
  id              String           @id @default(cuid())
  name            String           @db.VarChar(120)
  level           EducationLevel
  group           GroupType
  batchYear       Int
  examDate        DateTime?
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  studentProfiles StudentProfile[]
  subjects        Subject[]

  @@unique([level, group, batchYear])
}

model Subject {
  id                String             @id @default(cuid())
  trackId           String
  name              String             @db.VarChar(80)
  order             Int                @default(0)
  isArchived        Boolean            @default(false)
  papers            Paper[]
  studyRoutineItems StudyRoutineItem[]
  track             Track              @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, name])
}

model Paper {
  id         String    @id @default(cuid())
  subjectId  String
  name       String    @db.VarChar(40)
  order      Int       @default(0)
  isArchived Boolean   @default(false)
  chapters   Chapter[]
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name])
}

model Chapter {
  id                 String                @id @default(cuid())
  paperId            String
  name               String                @db.VarChar(160)
  order              Int                   @default(0)
  examWeight         Float                 @default(1.0)
  masteryPassPercent Int                   @default(70)
  isFreePreview      Boolean               @default(false)
  isArchived         Boolean               @default(false)
  paper              Paper                 @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chapterMasteries   ChapterMastery[]
  playlists          ChapterPlaylist[]
  specialVideos      ChapterSpecialVideo[]
  chapterTips        ChapterTip[]
  externalExams      ExternalExam[]
  officialNotes      OfficialNote[]
  quizzes            Quiz[]
  studentNotes       StudentNote[]
  todoItems          TodoItem[]
  topics             Topic[]

  @@unique([paperId, name])
}

model Topic {
  id            String          @id @default(cuid())
  chapterId     String
  name          String          @db.VarChar(160)
  order         Int             @default(0)
  isArchived    Boolean         @default(false)
  externalExams ExternalExam[]
  quizQuestions QuizQuestion[]
  resources     Resource[]
  chapter       Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicProgress TopicProgress[]

  @@unique([chapterId, name])
}

model TopicProgress {
  id              String         @id @default(cuid())
  studentId       String
  topicId         String
  readDone        Boolean        @default(false)
  lectureDone     Boolean        @default(false)
  solvedDone      Boolean        @default(false)
  updatedAt       DateTime       @updatedAt
  clientUpdatedAt DateTime?
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic           Topic          @relation(fields: [topicId], references: [id])

  @@unique([studentId, topicId])
  @@index([topicId])
}

model ChapterMastery {
  id               String         @id @default(cuid())
  studentId        String
  chapterId        String
  status           MasteryStatus  @default(NOT_STARTED)
  markedCompleteAt DateTime?
  masteredAt       DateTime?
  chapter          Chapter        @relation(fields: [chapterId], references: [id])
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizAttempts     QuizAttempt[]

  @@unique([studentId, chapterId])
  @@index([chapterId, status])
}

model ChapterTip {
  id            String      @id @default(cuid())
  chapterId     String
  category      TipCategory
  title         String      @db.VarChar(160)
  youtubeUrl    String?     @db.VarChar(255)
  driveLink     String?     @db.VarChar(255)
  order         Int         @default(0)
  isArchived    Boolean     @default(false)
  addedByUserId String?
  createdAt     DateTime    @default(now())
  chapter       Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, category])
}

model Quiz {
  id        String         @id @default(cuid())
  chapterId String
  title     String         @default("Validation quiz") @db.VarChar(160)
  isActive  Boolean        @default(true)
  timeLimitMinutes Int?
  createdAt DateTime       @default(now())
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attempts  QuizAttempt[]
  questions QuizQuestion[]
}

model QuizQuestion {
  id           String  @id @default(cuid())
  quizId       String
  questionText String
  options      Json
  correctIndex Int
  explanation  String?
  order        Int     @default(0)
  topicId      String?
  quiz         Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic        Topic?  @relation(fields: [topicId], references: [id])
}

model QuizAttempt {
  id               String          @id @default(cuid())
  studentId        String
  quizId           String
  chapterMasteryId String?
  context          QuizContext     @default(AUTO_VALIDATION)
  score            Int
  totalQuestions   Int
  answers          Json
  attemptedAt      DateTime        @default(now())
  chapterMastery   ChapterMastery? @relation(fields: [chapterMasteryId], references: [id])
  quiz             Quiz            @relation(fields: [quizId], references: [id])
  student          StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([quizId])
}

model ChapterPlaylist {
  id            String                 @id @default(cuid())
  chapterId     String
  title         String                 @db.VarChar(160)
  youtubeUrl    String                 @db.VarChar(255)
  addedByUserId String?
  order         Int                    @default(0)
  isArchived    Boolean                @default(false)
  createdAt     DateTime               @default(now())
  channelUrl    String?                @db.VarChar(255)
  chapter       Chapter                @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  videos        ChapterPlaylistVideo[]
  reviews       PlaylistReview[]

  @@index([chapterId])
}

model ChapterPlaylistVideo {
  id            String          @id @default(cuid())
  playlistId    String
  title         String          @db.VarChar(160)
  youtubeUrl    String          @db.VarChar(255)
  order         Int             @default(0)
  isArchived    Boolean         @default(false)
  addedByUserId String?
  createdAt     DateTime        @default(now())
  playlist      ChapterPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  progress      PlaylistVideoProgress[]

  @@index([playlistId])
}


model PlaylistVideoProgress {
  id          String               @id @default(cuid())
  studentId   String
  videoId     String
  completed   Boolean              @default(false)
  completedAt DateTime?
  updatedAt   DateTime             @updatedAt
  student     StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video       ChapterPlaylistVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([videoId])
}

model PlaylistReview {
  id         String          @id @default(cuid())
  playlistId String
  studentId  String
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  playlist   ChapterPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([playlistId, studentId])
  @@index([playlistId])
}

model ChapterSpecialVideo {
  id            String          @id @default(cuid())
  chapterId     String
  tag           SpecialVideoTag
  title         String          @db.VarChar(160)
  url           String          @db.VarChar(255)
  order         Int             @default(0)
  isArchived    Boolean         @default(false)
  addedByUserId String?
  createdAt     DateTime        @default(now())
  chapter       Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, tag])
}

model StudentNote {
  id                String               @id @default(cuid())
  studentId         String
  chapterId         String
  title             String               @db.VarChar(160)
  fileUrl           String               @db.VarChar(255)
  isPublic          Boolean              @default(false)
  moderationStatus  NoteModerationStatus @default(PENDING)
  moderatedByUserId String?
  pointsAwarded     Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  chapter           Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  student           StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comments          StudentNoteComment[]
  likes             StudentNoteLike[]
  ratings           StudentNoteRating[]

  @@index([chapterId, isPublic, moderationStatus])
  @@index([studentId])
}

model StudentNoteLike {
  id        String         @id @default(cuid())
  noteId    String
  studentId String
  createdAt DateTime       @default(now())
  note      StudentNote    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([noteId, studentId])
  @@index([noteId])
}

model StudentNoteRating {
  id        String         @id @default(cuid())
  noteId    String
  studentId String
  rating    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  note      StudentNote    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([noteId, studentId])
  @@index([noteId])
}

model StudentNoteComment {
  id        String         @id @default(cuid())
  noteId    String
  studentId String
  body      String         @db.VarChar(500)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  note      StudentNote    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
}

model OfficialNote {
  id              String     @id @default(cuid())
  chapterId       String
  title           String     @db.VarChar(160)
  fileUrl         String     @db.VarChar(255)
  accessType      AccessType @default(SUBSCRIPTION)
  order           Int        @default(0)
  isArchived      Boolean    @default(false)
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  chapter         Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Resource {
  id              String       @id @default(cuid())
  topicId         String
  kind            ResourceKind
  videoType       VideoType?
  title           String       @db.VarChar(160)
  url             String?      @db.VarChar(255)
  body            String?
  instructorName  String?      @db.VarChar(120)
  durationMinutes Int?
  accessType      AccessType   @default(FREE)
  paidBatchId     String?
  order           Int          @default(0)
  addedByAdminId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  paidBatch       PaidBatch?   @relation(fields: [paidBatchId], references: [id], onDelete: Restrict)
  topic           Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, kind])
  @@index([paidBatchId])
}

model PaidBatch {
  id          String     @id @default(cuid())
  title       String     @db.VarChar(160)
  description String?
  priceCents  Int
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
  resources   Resource[]
}

model Purchase {
  id               String    @id @default(cuid())
  userId           String
  paidBatchId      String
  amountPaidCents  Int
  paymentReference String?   @db.VarChar(160)
  purchasedAt      DateTime  @default(now())
  paidBatch        PaidBatch @relation(fields: [paidBatchId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, paidBatchId])
  @@index([paidBatchId])
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @db.VarChar(80)
  priceCents    Int
  interval      String         @db.VarChar(20)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  planId           String?
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  paymentReference String?            @db.VarChar(160)
  grantedByUserId  String?
  createdAt        DateTime           @default(now())
  plan             Plan?              @relation(fields: [planId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
}

model ExternalExam {
  id          String       @id @default(cuid())
  chapterId   String
  topicId     String?
  title       String       @db.VarChar(160)
  externalUrl String       @db.VarChar(255)
  provider    String       @db.VarChar(80)
  accessType  AccessType   @default(FREE)
  scheduledAt DateTime
  maxMarks    Float
  createdAt   DateTime     @default(now())
  results     ExamResult[]
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  todoItems   TodoItem[]

  @@index([chapterId])
  @@index([topicId])
}

model ExamResult {
  id                 String           @id @default(cuid())
  examId             String
  studentId          String
  phoneNumberUsed    String           @db.VarChar(20)
  marksObtained      Float?
  breakdown          Json?
  status             ExamResultStatus @default(PENDING)
  rawPayload         Json?
  fetchedAt          DateTime?
  reconciledByUserId String?
  createdAt          DateTime         @default(now())
  exam               ExternalExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student            StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([status])
}

model StudySession {
  id              String             @id @default(cuid())
  studentId       String
  subjectId       String?
  chapterId       String?
  type            SessionType        @default(POMODORO)
  status          StudySessionStatus @default(ACTIVE)
  startedAt       DateTime
  lastHeartbeatAt DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  student         StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startedAt])
  @@index([status, lastHeartbeatAt])
}

model StudyRoutine {
  id        String             @id @default(cuid())
  studentId String
  title     String             @default("My routine") @db.VarChar(120)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  student   StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items     StudyRoutineItem[]

  @@index([studentId, isActive])
}

model TodoItem {
  id                  String            @id @default(cuid())
  studentId           String
  title               String            @db.VarChar(200)
  dueDate             DateTime?
  completed           Boolean           @default(false)
  sourceType          TodoSourceType    @default(MANUAL)
  linkedChapterId     String?
  linkedExamId        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sourceRoutineItemId String?
  linkedChapter       Chapter?          @relation(fields: [linkedChapterId], references: [id])
  linkedExam          ExternalExam?     @relation(fields: [linkedExamId], references: [id])
  sourceRoutineItem   StudyRoutineItem? @relation(fields: [sourceRoutineItemId], references: [id])
  student             StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sourceRoutineItemId, dueDate])
  @@index([studentId, completed])
}

model StudyRoutineItem {
  id          String       @id @default(cuid())
  routineId   String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  subjectId   String?
  label       String?      @db.VarChar(160)
  routine     StudyRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  subject     Subject?     @relation(fields: [subjectId], references: [id])
  todoItems   TodoItem[]

  @@index([routineId, dayOfWeek])
}

model PointTransaction {
  id          String         @id @default(cuid())
  studentId   String
  points      Int
  reason      PointReason
  referenceId String?
  createdAt   DateTime       @default(now())
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model LevelThreshold {
  level     Int     @id
  minPoints Int     @unique
  title     String? @db.VarChar(60)
}

model PointRule {
  id             String      @id @default(cuid())
  reason         PointReason @unique
  scoringMode    ScoringMode @default(FLAT)
  value          Float
  isActive       Boolean     @default(true)
  updatedAt      DateTime    @updatedAt
  secondaryValue Float?
}

model LeaderboardSnapshot {
  id        String            @id @default(cuid())
  studentId String
  trackId   String
  metric    LeaderboardMetric
  period    LeaderboardPeriod
  periodKey String
  value     Int
  updatedAt DateTime          @updatedAt
  student   StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, metric, period, periodKey])
  @@index([trackId, metric, period, periodKey, value])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String           @db.VarChar(160)
  body         String
  isRead       Boolean          @default(false)
  scheduledFor DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(40)
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  admin      User     @relation("StaffAuditLogs", fields: [adminId], references: [id])

  @@index([entityType, entityId])
}

model Feedback {
  id               String            @id @default(cuid())
  studentId        String
  category         FeedbackCategory
  message          String
  isReviewed       Boolean          @default(false)
  reviewedByUserId String?
  createdAt        DateTime         @default(now())
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([isReviewed, createdAt])
}

enum Role {
  STUDENT
  MANAGER
  ADMIN
}

enum GroupType {
  SCIENCE
  ARTS
  COMMERCE
}

enum EducationLevel {
  SSC
  HSC
}

enum Board {
  DHAKA
  RAJSHAHI
  CUMILLA
  JASHORE
  CHATTOGRAM
  BARISHAL
  SYLHET
  DINAJPUR
  MYMENSINGH
  MADRASAH
  TECHNICAL
}

enum MasteryStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_QUIZ
  MASTERED
  NEEDS_REVIEW
}

enum ResourceKind {
  VIDEO
  PAID_ITEM
}

enum VideoType {
  ONESHOT
  FULL_LECTURE
  PAID_BATCH
}

enum AccessType {
  FREE
  SUBSCRIPTION
  BATCH_PURCHASE
}

enum QuizContext {
  AUTO_VALIDATION
  PRACTICE
}

enum SessionType {
  POMODORO
  FREE_STUDY
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  ENDED
  ABANDONED
}

enum PointReason {
  CHAPTER_MASTERED
  QUIZ_ATTEMPT
  STREAK_BONUS
  MANUAL_ADJUSTMENT
  EXTERNAL_EXAM_RESULT
  NOTE_UPLOADED
  PLAYLIST_REVIEWED
}

enum ScoringMode {
  FLAT
  PER_MARK
  PER_WEIGHT
}

enum LeaderboardMetric {
  STUDY_TIME
  MASTER_SCORE
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum TodoSourceType {
  MANUAL
  ROUTINE_GENERATED
  EXAM_REMINDER
}

enum SpecialVideoTag {
  ONE_SHOT
  ADMISSION
  MOTIVATION
  TRICK
  OTHER
}

enum NoteModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamResultStatus {
  PENDING
  MATCHED
  UNMATCHED
  DISPUTED
}

enum NotificationType {
  DAILY_REMINDER
  STREAK_RISK
  RECOMMENDATION
  PACE_ALERT
  SYSTEM
  CHAPTER_NEEDS_REVIEW
  LEVEL_UP
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TipCategory {
  LAW
  SHORTCUT
  CALCULATOR_HACK
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  GENERAL
}
